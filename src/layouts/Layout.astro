---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import BackgroundVideo from '../components/home/BackgroundVideo.astro';
import PersonalPanel from '../components/home/PersonalPanel.astro';
import StatsPanel from '../components/home/StatsPanel.astro';
import TopBar from '../components/home/TopBar.astro';
import { siteConfig, tagColors } from '../config';
import SplashScreen from '../splashScreen/SplashScreen';

interface Props {
	title?: string;
	description?: string;
	intro?: boolean;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
	intro = false,
} = Astro.props;
const posts = await getCollection('posts', ({ data }) => !data.draft);
const noteCount = posts.filter((post) => post.data.category === 'Notes').length;
const tagCount = Object.keys(tagColors).length;
---

<!doctype html>
<html lang="zh-CN" transition:name="root" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/image/favicon.ico" />
		<link
			rel="preload"
			as="image"
			type="image/jpeg"
			href="/background/WUWA-poster.jpg"
			fetchpriority="high"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050911" />
		<style is:inline>
			html, body { margin: 0; min-height: 100%; background: #071421; }
			.home-stage { min-height: 100svh; background: #050911; }
			.home-boot-surface {
				position: fixed;
				inset: 0;
				z-index: 11;
				background: linear-gradient(180deg, #071827 0%, #071421 52%, #040a12 100%);
			}
		</style>
		<title>{ `${title} | ${description}` }</title>
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<div
			class="home-stage"
			data-home-stage
			data-reveal-state={intro ? 'waiting' : 'ready'}
			data-video-reveal-state={intro ? 'waiting' : 'ready'}
			data-route-reveal-state={intro ? 'waiting' : 'ready'}
		>
			{intro && (
				<div class="home-boot-surface" data-home-boot aria-hidden="true"></div>
			)}
			<div data-webgl-shell>
				<BackgroundVideo revealed={!intro} />
				<SplashScreen intro={intro} client:load />
			</div>
			<div data-page-shell>
				<TopBar revealed={!intro} />
				<main
					class="relative z-20 mx-auto grid w-[min(calc(100%-1.5rem),1280px)] grid-cols-1 items-start gap-4 px-0 pb-12 pt-8 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-5 md:px-1 xl:grid-cols-[15rem_minmax(0,1fr)_13rem]"
					data-home-content
				>
					<div class="contents md:col-start-1 md:row-start-1 md:grid md:content-start md:gap-5 xl:contents">
						<PersonalPanel revealed={!intro} />
						<StatsPanel
							postCount={posts.length}
							noteCount={noteCount}
							tagCount={tagCount}
							revealed={!intro}
						/>
					</div>
					<slot />
				</main>
				<button
					class="back-to-top"
					type="button"
					aria-label="回到页面顶部"
					title="回到顶部"
					data-back-to-top
					data-visible="false"
				>
					<span aria-hidden="true">↑</span>
				</button>
			</div>
		</div>
		<script>
			import { gsap } from 'gsap';
			import { navigate, swapFunctions } from 'astro:transitions/client';
			import { activateArticleAudio, deactivateArticleAudio } from '../scripts/articleAudio';
			import { initBackgroundVideo } from '../scripts/backgroundVideo';

			interface CachedPage {
				shell: HTMLElement;
				head: HTMLHeadElement;
				htmlAttributes: Array<[string, string]>;
				bodyAttributes: Array<[string, string]>;
			}

			const pageCache = new Map<string, CachedPage>();
			const MAX_CACHED_ROUTES = 5;
			let routeCacheBound = false;
			let activeNavigation: {
				key: string;
				href: string;
				resolve: () => void;
				completion: Promise<void>;
				watchdog: number;
			} | null = null;
			let swappedNavigationKey: string | null = null;
			let scrollChromeAbort: AbortController | null = null;
			let scrollChromeButton: HTMLButtonElement | null = null;
			const NAVIGATION_WATCHDOG_MS = 30000;

			const routeKey = (url = window.location.href) => {
				const parsed = new URL(url, window.location.href);
				return `${parsed.pathname}${parsed.search}`;
			};

			const snapshotAttributes = (element: Element) => (
				Array.from(element.attributes, ({ name, value }) => [name, value] as [string, string])
			);
			const snapshotPageAttributes = (element: Element) => (
				snapshotAttributes(element).filter(([name]) => (
					name !== 'data-navigation-busy' && name !== 'data-astro-transition'
				))
			);

			const applyAttributes = (element: Element, attributes: Array<[string, string]>) => {
				Array.from(element.attributes).forEach(({ name }) => element.removeAttribute(name));
				attributes.forEach(([name, value]) => element.setAttribute(name, value));
			};

			const storeCachedPage = (key: string, page: CachedPage) => {
				pageCache.delete(key);
				pageCache.set(key, page);
				while (pageCache.size > MAX_CACHED_ROUTES) {
					const oldestKey = pageCache.keys().next().value;
					if (oldestKey === undefined) break;
					pageCache.delete(oldestKey);
				}
			};

			const cacheCurrentPage = (url = window.location.href) => {
				const shell = document.querySelector<HTMLElement>('[data-page-shell]');
				if (!shell) return;
				storeCachedPage(routeKey(url), {
					shell,
					head: document.head.cloneNode(true) as HTMLHeadElement,
					htmlAttributes: snapshotPageAttributes(document.documentElement),
					bodyAttributes: snapshotAttributes(document.body),
				});
			};

			const setPageActive = (shell: HTMLElement, active: boolean) => {
				shell.inert = !active;
				shell.dataset.pageState = active ? 'active' : 'inactive';
				if (active) activateArticleAudio(shell);
				else {
					deactivateArticleAudio(shell);
					shell.querySelectorAll<HTMLVideoElement>('video').forEach((media) => media.pause());
				}
			};

			const startNavigation = (url: URL) => {
				if (activeNavigation) return activeNavigation;
				const key = routeKey(url.href);
				let resolve = () => {};
				const completion = new Promise<void>((complete) => { resolve = complete; });
				const navigation = {
					key,
					href: url.href,
					resolve,
					completion,
					watchdog: 0,
				};
				activeNavigation = navigation;
				document.documentElement.setAttribute('data-navigation-busy', 'true');
				navigation.watchdog = window.setTimeout(() => {
					if (activeNavigation !== navigation) return;
					window.location.assign(navigation.href);
				}, NAVIGATION_WATCHDOG_MS);
				void completion.finally(() => {
					if (activeNavigation !== navigation) return;
					window.clearTimeout(navigation.watchdog);
					activeNavigation = null;
					document.documentElement.removeAttribute('data-navigation-busy');
				});
				return navigation;
			};

			const completeNavigation = (key: string) => {
				if (activeNavigation?.key !== key) return;
				activeNavigation.resolve();
			};

			const ensureBackgroundVideoSource = () => {
				const video = document.querySelector<HTMLVideoElement>('#background-video');
				if (!video) return;
				initBackgroundVideo(video);
			};

			const bindRouteCache = () => {
				if (routeCacheBound) return;
				routeCacheBound = true;
				cacheCurrentPage();

				window.addEventListener('click', (event) => {
					if (!(event.target instanceof Element)) return;
					const link = event.target.closest<HTMLAnchorElement>('a[href]');
					if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
					if (link.hasAttribute('download') || link.dataset.astroReload !== undefined || link.target && link.target !== '_self') return;
					const target = new URL(link.href, window.location.href);
					if (target.origin !== window.location.origin || target.hash) return;
					const targetKey = routeKey(target.href);
					if (targetKey === routeKey()) {
						event.preventDefault();
						return;
					}
					event.preventDefault();
					if (activeNavigation) return;

					const navigation = startNavigation(target);
					void navigate(target.href).catch(() => {
						if (activeNavigation === navigation) window.location.assign(target.href);
					});
				}, { capture: true });
			};

			const loadArticleMedia = () => {
				activateArticleAudio(document);
			};

			const updateTagResults = () => {
				const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tag-post]'));
				if (!cards.length) return;

				const selectedTag = new URLSearchParams(window.location.search).get('tag')?.trim() ?? '';
				const title = document.querySelector<HTMLElement>('[data-tag-title]');
				const description = document.querySelector<HTMLElement>('[data-tag-description]');
				const empty = document.querySelector<HTMLElement>('[data-tag-empty]');
				let visibleCount = 0;

				cards.forEach((card) => {
					const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
					const visible = Boolean(selectedTag) && tags.includes(selectedTag);
					card.hidden = !visible;
					if (visible) visibleCount += 1;
				});

				if (title) title.textContent = selectedTag ? `标签：${selectedTag}` : '标签文章';
				if (description) {
					description.textContent = selectedTag
						? `与“${selectedTag}”关联的已发布文章，按发布时间由新到旧排列。`
						: '请选择一个标签以筛选已发布文章。';
				}
				if (empty) empty.hidden = visibleCount > 0 || !selectedTag;
			};

			const bindScrollChrome = () => {
				const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
				if (!button || button === scrollChromeButton) return;
				scrollChromeAbort?.abort();
				scrollChromeAbort = new AbortController();
				scrollChromeButton = button;
				const { signal } = scrollChromeAbort;
				button.dataset.scrollBound = 'true';

				let frame = 0;
				let topBarHidden = false;
				let scrollTween: ReturnType<typeof gsap.to> | null = null;
				const update = () => {
					frame = 0;
					const topBar = document.querySelector<HTMLElement>('.top-bar');
					const hideThreshold = window.matchMedia('(max-width: 767px)').matches ? 72 : 120;
					const shouldHide = window.scrollY > hideThreshold;
					if (!topBar || shouldHide === topBarHidden) return;

					topBarHidden = shouldHide;
					gsap.killTweensOf(topBar);
					if (shouldHide) {
						topBar.classList.remove('is-menu-open');
						document.documentElement.classList.remove('nav-drawer-open');
						document.querySelector<HTMLElement>('[data-mobile-nav-drawer]')?.setAttribute('aria-hidden', 'true');
						topBar.querySelector<HTMLButtonElement>('.nav-menu-button')?.setAttribute('aria-expanded', 'false');
						button.dataset.visible = 'false';
						gsap.to(topBar, {
							yPercent: -125,
							opacity: 0,
							duration: 0.2,
							ease: 'power2.in',
							overwrite: true,
							onStart: () => { topBar.style.pointerEvents = 'none'; },
							onComplete: () => {
								if (topBarHidden) button.dataset.visible = 'true';
							},
						});
					} else {
						button.dataset.visible = 'false';
						gsap.to(topBar, {
							yPercent: 0,
							opacity: 1,
							duration: 0.4,
							ease: 'power2.out',
							overwrite: true,
							onComplete: () => { topBar.style.pointerEvents = ''; },
						});
					}
				};

				const scheduleUpdate = () => {
					if (frame !== 0) return;
					frame = window.requestAnimationFrame(update);
				};

				button.addEventListener('click', () => {
					const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					const scrollPosition = { y: window.scrollY };
					scrollTween?.kill();
					scrollTween = gsap.to(scrollPosition, {
						y: 0,
						duration: reduceMotion ? 0 : 0.2,
						ease: 'power3.out',
						overwrite: true,
						onUpdate: () => window.scrollTo(0, scrollPosition.y),
						onComplete: () => {
							window.scrollTo(0, 0);
							scheduleUpdate();
						},
					});
				}, { signal });
				window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
				window.addEventListener('resize', scheduleUpdate, { passive: true, signal });
				document.addEventListener('astro:after-swap', scheduleUpdate, { signal });
				update();
			};

			document.addEventListener('astro:page-load', bindScrollChrome);
			document.addEventListener('astro:page-load', loadArticleMedia);
			document.addEventListener('astro:page-load', updateTagResults);
			document.addEventListener('astro:page-load', ensureBackgroundVideoSource);
			document.addEventListener('astro:page-load', bindRouteCache);
			document.addEventListener('astro:page-load', () => {
				if (!swappedNavigationKey) return;
				completeNavigation(swappedNavigationKey);
				swappedNavigationKey = null;
			});
			bindScrollChrome();
			loadArticleMedia();
			updateTagResults();
			ensureBackgroundVideoSource();
			bindRouteCache();

			document.addEventListener('astro:before-preparation', (event) => {
				const targetKey = routeKey(event.to.href);
				const cached = pageCache.get(targetKey);
				if (!cached) return;
				pageCache.delete(targetKey);

				event.loader = async () => {
					const nextDocument = document.implementation.createHTMLDocument('');
					nextDocument.head.replaceWith(cached.head.cloneNode(true));
					applyAttributes(nextDocument.documentElement, cached.htmlAttributes);
					applyAttributes(nextDocument.body, cached.bodyAttributes);
					nextDocument.body.replaceChildren(cached.shell);
					event.newDocument = nextDocument;
				};

				event.signal.addEventListener('abort', () => {
					if (!pageCache.has(targetKey)) storeCachedPage(targetKey, cached);
				}, { once: true });
			});

			document.addEventListener('astro:before-swap', (event) => {
				const currentPageShell = document.querySelector<HTMLElement>('[data-page-shell]');
				const nextPageShell = event.newDocument.querySelector<HTMLElement>('[data-page-shell]');
				if (!currentPageShell || !nextPageShell) return;
				cacheCurrentPage(event.from.href);
				setPageActive(currentPageShell, false);
				const targetKey = routeKey(event.to.href);
				swappedNavigationKey = targetKey;

				event.swap = () => {
					const waterMode = document.documentElement.dataset.waterMode;
					swapFunctions.deselectScripts(event.newDocument);
					swapFunctions.swapRootAttributes(event.newDocument);
					if (waterMode) document.documentElement.dataset.waterMode = waterMode;
					swapFunctions.swapHeadElements(event.newDocument);
					const restoreFocus = swapFunctions.saveFocus();
					currentPageShell.replaceWith(nextPageShell);
					setPageActive(nextPageShell, true);
					restoreFocus();
				};
			});

			document.addEventListener('astro:after-swap', () => {
				ensureBackgroundVideoSource();
				loadArticleMedia();
				updateTagResults();
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const route = document.querySelector<HTMLElement>('.route-panel');
				if (!route) return;

				const animation = route.animate(
					[
						{ opacity: 0, transform: 'translateY(28px)' },
						{ opacity: 1, transform: 'translateY(0)' },
					],
					{
						duration: 420,
						easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
						fill: 'both',
					},
				);
				void animation.finished.then(() => animation.cancel(), () => undefined);
			});
		</script>
	</body>
</html>
