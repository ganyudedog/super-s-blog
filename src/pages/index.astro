---
import Layout from '../layouts/Layout.astro';
import HomeView from '../components/home/HomeView.astro';
---

<Layout title="super's blog | code, graphics and notes" intro>
	<HomeView />
</Layout>

<script>
	import { initHomeReveal } from '../scripts/homeReveal';

	window.addEventListener('home:revealed', () => {
		if (window.location.pathname === '/') {
			window.history.replaceState(window.history.state, '', '/index');
		}
	}, { once: true });
	initHomeReveal();
</script>
