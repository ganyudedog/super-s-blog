---
import { getCollection } from 'astro:content';
import PostCard from '../components/blog/PostCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';

const notes = (await getCollection('posts', ({ data }) => !data.draft && data.category === 'Notes'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<ContentLayout title="笔记" description="短篇技术笔记与观察">
  <header class="mb-5 px-1 text-slate-100">
    <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-amber-200/85">NOTES</p>
    <h1 class="m-0 text-3xl font-semibold">随手笔记</h1>
    <p class="mt-2 text-sm text-slate-300">尚未长成文章，但值得留下的判断与线索。</p>
  </header>
  <div class="grid gap-3">
    {notes.map((post) => <PostCard post={post} />)}
  </div>
</ContentLayout>
