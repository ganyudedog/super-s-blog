---
import { getCollection } from 'astro:content';
import PostCard from '../components/blog/PostCard.astro';
import ContentLayout from '../layouts/ContentLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<ContentLayout title="标签文章" description="按标签浏览全部已发布的笔记与随笔">
  <header class="mb-5 px-1 text-slate-100">
    <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-cyan-200/85">TAGS</p>
    <h1 class="m-0 text-3xl font-semibold" data-tag-title>标签文章</h1>
    <p class="mt-2 text-sm text-slate-300" data-tag-description>请选择一个标签以筛选已发布文章。</p>
  </header>

  <div class="grid gap-3" data-tag-post-list>
    {posts.map((post) => (
      <div data-tag-post data-tags={post.data.tags.join(',')}>
        <PostCard post={post} />
      </div>
    ))}
  </div>

  <section class="route-document rounded-lg border border-white/15 px-5 py-8 text-slate-300" data-tag-empty hidden>
    <h2 class="m-0 text-xl font-semibold text-slate-100">没有匹配的文章</h2>
    <p class="mb-0 mt-3 text-sm leading-7">这个标签暂时还没有关联已发布的文章。</p>
  </section>
</ContentLayout>
