---
import ContentLayout from '../layouts/ContentLayout.astro';
import { friendItems, friendSiteInfo } from '../config';
---

<ContentLayout title="友链" description="关于成长路上遇见的有趣朋友。">
  <article class="route-document px-1 py-5 text-[0.95rem] leading-8 text-slate-100/90 md:px-2 md:py-7">
    <header>
      <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-rose-200/85">FRIENDS</p>
      <h1 class="m-0 text-3xl font-semibold text-slate-100">友人帐</h1>
      <p class="mb-0 mt-3 max-w-[62ch] text-sm leading-7 text-slate-200/90">
        记录在互联网一隅偶然相遇，又愿意彼此留下入口的人。
      </p>
    </header>

    <section class="mt-6" aria-labelledby="friend-list-title">
      <h2 id="friend-list-title" class="sr-only">友链列表</h2>
      {friendItems.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2">
          {friendItems.map((friend) => (
            <a
              class="route-item friend-card group flex min-w-0 items-center gap-4 rounded-lg border border-white/25 p-4 transition hover:-translate-y-0.5 hover:border-cyan-100/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-100"
              href={friend.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`访问 ${friend.name}（新窗口打开）`}
            >
              <img
                class="size-12 shrink-0 rounded-md border border-white/25 bg-white/10 object-cover"
                src={friend.avatar}
                alt=""
                width="48"
                height="48"
                loading="lazy"
                aria-hidden="true"
              />
              <span class="min-w-0">
                <strong class="block truncate text-base font-semibold text-white transition group-hover:text-cyan-50">
                  {friend.name}
                </strong>
                <span class="mt-1 block text-sm leading-6 text-slate-200/90">{friend.description}</span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="route-item friend-card rounded-lg border border-dashed border-white/30 px-4 py-6 text-center">
          <p class="m-0 font-medium text-white">这里暂时还是一片等待相遇的空地。</p>
          <p class="mb-0 mt-1 text-sm text-slate-200/85">第一批友链会从这里开始生长。</p>
        </div>
      )}
    </section>

    <section class="mt-7 border-t border-dashed border-white/25 pt-5" aria-labelledby="friend-apply-title">
      <h2 id="friend-apply-title" class="m-0 text-base font-semibold text-slate-100">添加友链</h2>
      <p class="mb-0 mt-2 max-w-[68ch] text-sm leading-7 text-slate-200/90">
        友链申请暂未开放。后续开放时，为了方便确认，请附上以下信息：
      </p>
      <ul class="mt-3 grid list-none gap-2 p-0 text-sm sm:grid-cols-2">
        <li class="route-item friend-card rounded-lg border border-white/25 px-3 py-2 text-slate-50"><span class="mr-2 text-cyan-100">01</span>站点名称</li>
        <li class="route-item friend-card rounded-lg border border-white/25 px-3 py-2 text-slate-50"><span class="mr-2 text-amber-100">02</span>站点地址</li>
        <li class="route-item friend-card rounded-lg border border-white/25 px-3 py-2 text-slate-50"><span class="mr-2 text-rose-100">03</span>头像或图标地址</li>
        <li class="route-item friend-card rounded-lg border border-white/25 px-3 py-2 text-slate-50"><span class="mr-2 text-emerald-100">04</span>一句话简介</li>
      </ul>

      <aside class="route-item friend-card mt-5 rounded-lg border border-white/25 p-4" aria-labelledby="friend-site-info-title">
        <div class="flex items-center gap-3">
          <img
            class="size-12 shrink-0 rounded-md border border-white/25 bg-white/10 object-cover"
            src={friendSiteInfo.avatar}
            alt={`${friendSiteInfo.name} 图标`}
            width="48"
            height="48"
          />
          <div class="min-w-0">
            <h3 id="friend-site-info-title" class="m-0 truncate text-base font-semibold text-white">本站信息</h3>
            <p class="m-0 mt-0.5 truncate text-xs text-slate-200/80">{friendSiteInfo.name}</p>
          </div>
        </div>
        <dl class="mb-0 mt-4 grid gap-3 border-t border-white/20 pt-4 text-sm">
          <div>
            <dt class="text-xs text-slate-200/75">站点名称</dt>
            <dd class="m-0 mt-1 font-medium text-white">{friendSiteInfo.name}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-200/75">站点简介</dt>
            <dd class="m-0 mt-1 text-slate-50">{friendSiteInfo.description}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-200/75">站点图标</dt>
            <dd class="m-0 mt-1 font-mono text-xs text-cyan-50">{friendSiteInfo.avatar}</dd>
          </div>
        </dl>
      </aside>
    </section>
  </article>
</ContentLayout>

<style>
  .friend-card {
    background: rgba(218, 237, 255, 0.13);
  }

  a.friend-card:hover,
  a.friend-card:focus-visible {
    background: rgba(225, 243, 255, 0.19);
  }
</style>
