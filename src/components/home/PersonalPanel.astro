---
import { siteConfig } from '../../config';

interface Props {
  revealed?: boolean;
}

const { revealed = false } = Astro.props;
---

<aside
  class:list={[
    'glass-panel personal-panel order-1 p-4 md:col-start-1 md:row-start-1 md:p-5 xl:row-span-2',
    revealed ? 'opacity-100' : 'opacity-0',
  ]}
  data-reveal-left
  aria-labelledby="personal-title"
  transition:name="site-personal-panel"
  transition:persist
>
  <div class="personal-identity flex items-center gap-3">
    <div class="profile-mark grid size-14 shrink-0 place-items-center rounded-full border border-cyan-200/35 bg-slate-950/75 text-xl font-extrabold text-cyan-100" aria-hidden="true">S</div>
    <div>
      <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-cyan-200/85">PROFILE</p>
      <h2 id="personal-title" class="m-0 text-base font-semibold text-slate-100">{siteConfig.author.name}</h2>
      <p class="mt-1 text-xs leading-5 text-amber-200/80">{siteConfig.author.role}</p>
    </div>
  </div>

  <p class="my-5 text-[0.8rem] leading-7 text-slate-300">
    {siteConfig.author.bio}
  </p>

  <dl class="m-0 border-y border-white/10">
    <div class="grid gap-1 border-b border-white/10 py-2.5 text-xs md:grid-cols-[1fr_auto] md:items-center">
      <dt class="text-slate-400">当前关注</dt>
      <dd class="m-0 font-semibold text-slate-200 md:text-right">{siteConfig.author.focus}</dd>
    </div>
    <div class="grid gap-1 py-2.5 text-xs md:grid-cols-[1fr_auto] md:items-center">
      <dt class="text-slate-400">所在地</dt>
      <dd class="m-0 font-semibold text-slate-200 md:text-right">{siteConfig.author.location}</dd>
    </div>
  </dl>

  <div class="mt-4 grid grid-cols-2 gap-2">
    <a class="rounded-md border border-cyan-200/20 bg-cyan-100/10 px-2 py-2 text-center text-xs font-semibold text-cyan-100 transition hover:bg-cyan-100/20" href={siteConfig.author.github} rel="noreferrer">GitHub</a>
    <a class="rounded-md border border-rose-200/20 bg-rose-100/10 px-2 py-2 text-center text-xs font-semibold text-rose-100 transition hover:bg-rose-100/20" href={`mailto:${siteConfig.author.email}`}>Email</a>
  </div>
</aside>
