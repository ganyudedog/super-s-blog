---
import { siteConfig } from '../../config';

interface Props {
  revealed?: boolean;
}

const { revealed = false } = Astro.props;
---

<aside
  class:list={[
    'glass-panel personal-panel order-1 p-4 md:col-start-1 md:row-start-1 md:p-5 xl:row-span-2',
    revealed ? 'opacity-100' : 'opacity-0',
  ]}
  data-reveal-left
  aria-labelledby="personal-title"
  transition:name="site-personal-panel"
  transition:persist
>
  <div class="personal-identity gap-3">
    <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-cyan-200/85">PROFILE</p>
    <div class="profile-mark size-50 shrink-0 m-auto rounded-full border border-cyan-200/35 overflow-hidden" aria-hidden="true">
      <img src="/image/head.jpg" class="w-full hover:contrast-130" alt="甘雨好看捏">
    </div>
    <div class="mt-2 text-center">
      <h2 id="personal-title" class="m-0 text-base font-semibold text-slate-100">{siteConfig.author.name}</h2>
      <p class="mt-1 text-xs leading-5 text-amber-200/80">{siteConfig.author.role}</p>
    </div>
  </div>

  <p class="my-5 text-[0.8rem] leading-7 text-slate-300 text-center">
    {siteConfig.author.bio}
  </p>

  <dl class="m-0 border-y border-white/10">
    <div class="grid gap-1 border-b border-white/10 py-2.5 text-xs md:grid-cols-[1fr_auto] md:items-center">
      <dt class="text-slate-400">当前关注</dt>
      <dd class="m-0 font-semibold text-slate-200 md:text-right">{siteConfig.author.focus}</dd>
    </div>
    <div class="grid gap-1 py-2.5 text-xs md:grid-cols-[1fr_auto] md:items-center">
      <dt class="text-slate-400">所在地</dt>
      <dd class="m-0 font-semibold text-slate-200 md:text-right">{siteConfig.author.location}</dd>
    </div>
  </dl>

  <div class="mt-4 grid grid-cols-2 gap-2">
    <a class="inline-flex items-center justify-center gap-2 rounded-md border border-cyan-200/20 bg-cyan-100/10 px-2 py-2 text-center text-xs font-semibold text-cyan-100 transition hover:bg-cyan-100/20" href={siteConfig.author.github} rel="noreferrer" target="_blank">
      <img class="size-4" src="https://api.iconify.design/simple-icons:github.svg?color=%23cffafe" alt="" width="16" height="16" aria-hidden="true" />
      <span>GitHub</span>
    </a>
    <a class="inline-flex items-center justify-center gap-2 rounded-md border border-rose-200/20 bg-rose-100/10 px-2 py-2 text-center text-xs font-semibold text-rose-100 transition hover:bg-rose-100/20" href={`mailto:${siteConfig.author.email}`}>
      <img class="size-4" src="https://api.iconify.design/lucide:mail.svg?color=%23ffe4e6" alt="" width="16" height="16" aria-hidden="true" />
      <span>Email</span>
    </a>
  </div>
</aside>
