---
import { getCollection } from 'astro:content';
import RoutePanel from './RoutePanel.astro';

interface Props {
  revealed?: boolean;
}

const { revealed = false } = Astro.props;
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<RoutePanel posts={posts.slice(0, 3)} revealed={revealed} />
