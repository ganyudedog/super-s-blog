---
import { siteConfig } from '../../config';

interface Props {
  postCount: number;
  noteCount: number;
  tagCount: number;
  revealed?: boolean;
}

const { postCount, noteCount, tagCount, revealed = false } = Astro.props;

const DAY_IN_MS = 86_400_000;

function getBeijingDaySerial(date = new Date()) {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
  }).formatToParts(date);
  const value = (type: Intl.DateTimeFormatPartTypes) =>
    Number(parts.find((part) => part.type === type)?.value);

  return Date.UTC(value('year'), value('month') - 1, value('day'));
}

function getRunningDays(publishTime: string) {
  const [year, month, day] = publishTime.split('-').map(Number);
  const publishDay = Date.UTC(year, month - 1, day);
  return Math.max(1, Math.floor((getBeijingDaySerial() - publishDay) / DAY_IN_MS) + 1);
}

const runningDays = getRunningDays(siteConfig.publishTime);
---

<aside
  class:list={[
    'glass-panel stats-panel order-2 hidden p-4 md:col-start-1 md:row-start-2 md:block md:p-5 xl:col-start-3 xl:row-start-1',
    revealed ? 'opacity-100' : 'opacity-0',
  ]}
  data-reveal-right
  aria-labelledby="stats-title"
  transition:name="site-stats-panel"
  transition:persist
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="mb-1 text-[0.62rem] font-extrabold tracking-[0.14em] text-cyan-200/85">OVERVIEW</p>
      <h2 id="stats-title" class="m-0 text-base font-semibold text-slate-100">站点统计</h2>
    </div>
    <span class="rounded bg-emerald-300/15 px-1.5 py-1 text-[0.55rem] font-extrabold tracking-[0.08em] text-emerald-200">LIVE</span>
  </div>

  <dl class="mt-4">
    <div class="flex items-baseline justify-between gap-3 border-b border-white/10 py-3">
      <dt class="text-xs text-slate-400">文章</dt>
      <dd class="m-0 font-mono text-lg font-extrabold text-slate-100">{postCount}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-3 border-b border-white/10 py-3">
      <dt class="text-xs text-slate-400">笔记</dt>
      <dd class="m-0 font-mono text-lg font-extrabold text-slate-100">{noteCount}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-3 py-3">
      <dt class="text-xs text-slate-400">标签</dt>
      <dd class="m-0 font-mono text-lg font-extrabold text-slate-100">{tagCount}</dd>
    </div>
  </dl>

  <div class="mt-3 text-[0.68rem] text-slate-400">
    <span class="block">持续运行</span>
    <strong
      class="mt-1 block text-xs text-amber-200/80"
      data-running-days
      data-publish-time={siteConfig.publishTime}
    >{runningDays} days</strong>
  </div>
</aside>

<script>
  const DAY_IN_MS = 86_400_000;

  const getBeijingDaySerial = () => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
    }).formatToParts(new Date());
    const value = (type: Intl.DateTimeFormatPartTypes) =>
      Number(parts.find((part) => part.type === type)?.value);

    return Date.UTC(value('year'), value('month') - 1, value('day'));
  };

  const updateRunningDays = () => {
    document.querySelectorAll<HTMLElement>('[data-running-days]').forEach((element) => {
      const [year, month, day] = (element.dataset.publishTime ?? '').split('-').map(Number);
      if (![year, month, day].every(Number.isFinite)) return;
      const publishDay = Date.UTC(year, month - 1, day);
      const runningDays = Math.max(1, Math.floor((getBeijingDaySerial() - publishDay) / DAY_IN_MS) + 1);
      element.textContent = `${runningDays} days`;
    });
  };

  updateRunningDays();
  document.addEventListener('astro:page-load', updateRunningDays);
</script>
