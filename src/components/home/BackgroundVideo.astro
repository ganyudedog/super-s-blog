---
interface Props {
  revealed?: boolean;
}

const { revealed = false } = Astro.props;
---

<div
  class:list={[
    'background-video-layer fixed inset-0 z-0 overflow-hidden pointer-events-none',
    revealed ? 'opacity-100' : 'opacity-0',
  ]}
  data-background-reveal
  data-static-background={revealed || undefined}
  aria-hidden="true"
>
  <video
    id="background-video"
    class="background-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/background/WUWA-poster.jpg"
    disablepictureinpicture
    controlslist="nodownload noplaybackrate nofullscreen"
    tabindex="-1"
    data-hls-desktop="/background/hls/desktop/master.m3u8"
    data-hls-mobile="/background/hls/mobile/master.m3u8"
    data-video-desktop="/media/background/WUWA-desktop.mp4"
    data-video-mobile="/media/background/WUWA-mobile.mp4"
  >
  </video>
  <div class="background-video-grade"></div>
</div>
